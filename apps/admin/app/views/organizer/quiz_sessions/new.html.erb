<% content_for :title, "開催回の作成" %>
<main id="main" class="page page--narrow">
  <h1 class="page-title">開催回の作成</h1>
  <p class="page-lead">作成した時点の質問解答（<%= current_user.questions.count %> 問）が、この開催回の問題になります。あとで問題を直しても、作成済みの開催回には反映されません。</p>

  <div class="card">
    <%= form_with model: @quiz_session, url: organizer_quiz_sessions_path, class: "form" do |form| %>
      <% if @quiz_session.errors.any? %>
        <ul class="form-errors error" role="alert">
          <% @quiz_session.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>

      <div class="field">
        <%= form.label :title, "開催回名" %>
        <%= form.text_field :title, required: true, maxlength: 100, size: 40 %>
      </div>
      <div class="form-actions">
        <%= form.submit "作成", class: "btn btn--primary", data: { turbo_submits_with: "作成中…" } %>
      </div>
    <% end %>
  </div>

  <p class="back-link"><%= link_to "トップへ戻る", root_path %></p>
</main>
