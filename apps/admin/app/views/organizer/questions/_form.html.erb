<%= form_with model: [:organizer, question], class: "form card", data: { controller: "image-preview" } do |form| %>
  <% if question.errors.any? %>
    <ul class="form-errors error" role="alert">
      <% question.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true, maxlength: 200, size: 60 %>
  </div>

  <div class="field">
    <%= form.label :image, "画像（任意。png / jpeg / webp / gif、5 MB 以下）" %>
    <% if question.image.attached? && question.image.persisted? %>
      <%= image_tag url_for(question.image), class: "preview", alt: "設定済みの画像", data: { image_preview_target: "preview" }, width: 240 %>
    <% else %>
      <img class="preview" alt="" width="240" hidden data-image-preview-target="preview">
    <% end %>
    <%= form.file_field :image, direct_upload: true, accept: Question::IMAGE_CONTENT_TYPES.join(","),
          data: { image_preview_target: "input", action: "change->image-preview#show direct-upload:progress->image-preview#progress direct-upload:error->image-preview#failed" } %>
    <span class="field__status" data-image-preview-target="status" role="status"></span>
  </div>

  <div class="choices">
    <% Question::CHOICE_COLUMNS.each do |column| %>
      <%# p だと、検証エラーで入力欄を包む div（field_with_errors）が入ったときにブラウザが p を閉じて並びが崩れるので div にする %>
      <div class="choice field">
        <%= form.label column %>
        <%= form.text_field column, required: true, maxlength: 50, size: 40 %>
      </div>
    <% end %>
  </div>

  <fieldset class="radio-group">
    <legend>正解の選択肢</legend>
    <% %w[A B C D].each_with_index do |label, index| %>
      <span class="radio-group__item">
        <%= form.radio_button :correct_index, index, required: true %>
        <%= form.label "correct_index_#{index}", label %>
      </span>
    <% end %>
  </fieldset>

  <div class="form-actions form-actions--sticky"><%= form.submit "保存", class: "btn btn--primary" %></div>
<% end %>
