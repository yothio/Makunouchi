<% content_for :title, "主催者の作成" %>
<main id="main" class="page page--narrow">
  <h1 class="page-title">主催者の作成</h1>

  <div class="card">
    <%= form_with model: @user, url: admin_organizers_path, class: "form" do |form| %>
      <% if @user.errors.any? %>
        <ul class="form-errors error" role="alert">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>

      <div class="field">
        <%= form.label :email, "メールアドレス" %>
        <%= form.email_field :email, required: true, autocomplete: "off" %>
      </div>
      <div class="field">
        <%= form.label :password, "パスワード" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password" %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "パスワード（確認）" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
      </div>
      <div class="form-actions">
        <%= form.submit "作成する", class: "btn btn--primary" %>
      </div>
    <% end %>
  </div>
</main>
