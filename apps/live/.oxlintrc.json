{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist/**",
    ".wrangler/**",
    "node_modules/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    // All functions are written as const arrow functions.
    "func-style": ["error", "expression"],
    // reconnecting-socket detaches handlers with `sock.onX = null` in drop(); addEventListener would
    // need handler bookkeeping for no behaviour gain, and its fake WebSocket tests use on* properties.
    "unicorn/prefer-add-event-listener": "off",
    // Side-effect-only imports are legitimate for stylesheets.
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    // 親ディレクトリへの相対 import は禁止し、@client / @shared / @worker で書く。同じディレクトリと子への ./ は許す。
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../*", "../**"],
            "message": "親ディレクトリへの相対 import ではなく、@client / @shared / @worker のエイリアスで書く。"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["test/worker/**/*.ts"],
      "rules": {
        // Worker socket tests assert via `guest.next(...)` / `host.next(...)`, which reject on timeout.
        "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expectTypeOf", "assert", "assertType", "*.next"] }]
      }
    },
    {
      "files": ["test/**/*.ts", "src/**/*.test.ts", "src/loadtest/**/*.ts", "scripts/**/*.ts"],
      "rules": {
        // Small local helpers inside describe/test blocks and drivers read better next to their use.
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": ["scripts/**/*.ts", "test/worker/load.test.ts"],
      "rules": {
        // scripts は Node が直接実行するのでエイリアスを解決できない。src/loadtest と fixtures を読む
        // load.test.ts にはエイリアスがないので、相対で書く。
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["scripts/**/*.ts"],
      "rules": {
        // `import WebSocket from "ws"` is the library's documented usage.
        "import/no-named-as-default": "off"
      }
    }
  ]
}
